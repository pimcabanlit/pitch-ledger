# Copy to .env for local overrides. Never commit .env.
# Everything runs locally and offline by default; no Azure settings are needed.
PITCH_LEDGER_DATA_DIR=data
PITCH_LEDGER_LOG_LEVEL=INFO

# Models (agents/model_manager.py is the only place model names are read).
# offline = deterministic templates, zero cost. foundry = Microsoft Foundry deployments.
PITCH_LEDGER_MODEL_PROVIDER=offline
# FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<project>
# PITCH_LEDGER_MODEL_STRONG=<deployment for Explainer, Auditor, Narrator>
# PITCH_LEDGER_MODEL_SMALL=<deployment for Personalizer, Translator>
# PITCH_LEDGER_MODEL_CALL_BUDGET=120
# Check the setup with `uv run pitch-ledger check-models` (one variable per line).

# Foundry sign-in uses Microsoft Entra ID (no API keys). Locally: `az login`.
# In a CI or cloud session, set these as secrets (never in this file or the repo):
# AZURE_TENANT_ID, AZURE_CLIENT_ID, AZURE_CLIENT_SECRET
# The service principal needs the Foundry User role on the Foundry resource. See docs/azure-setup.md.

# Live feed: file (default, local) or eventhubs (Azure Event Hubs or a Fabric Eventstream
# custom endpoint). See docs/azure-setup.md. One variable per line.
PITCH_LEDGER_FEED=file
# PITCH_LEDGER_FEED_FILE=data/feed/feed.jsonl
# Entra ID sign-in (preferred; uses the AZURE_* service principal or a managed identity):
# PITCH_LEDGER_EVENTHUB_NAMESPACE=<namespace>.servicebus.windows.net
# PITCH_LEDGER_EVENTHUB_NAME=match-feed
# Or a SAS connection string (a secret: environment settings only, never this file):
# PITCH_LEDGER_EVENTHUB_CONNECTION
# PITCH_LEDGER_EVENTHUB_CONSUMER_GROUP=$Default
# auto: plain AMQP (5671), or WebSockets (443) when HTTPS_PROXY is set; amqp | websockets force one
# PITCH_LEDGER_EVENTHUB_TRANSPORT=auto

# Event store: Azure Data Explorer free cluster (see docs/azure-setup.md)
# ADX_CLUSTER_URI=https://<cluster>.<region>.kusto.windows.net
# ADX_DATABASE=<database>
# file (default, data/store/*.jsonl) or adx
PITCH_LEDGER_STORE=file
