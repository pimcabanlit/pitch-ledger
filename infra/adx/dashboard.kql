// Pitch Ledger control room: ADX dashboard tile queries.
// Create the dashboard in the Azure Data Explorer web UI (Dashboards -> New dashboard),
// add the free cluster and database `matchdata` as the data source, add a parameter
// `_match_id` (single selection, query: Events | distinct match_id), then one tile per
// query below. Tiles only filter, order, round and chart rows the engine wrote; they
// never compute football metrics, so the dashboard shows the same numbers as the studio.
// Step-by-step: docs/azure-setup.md (Event store, Dashboard).

// Tile 1. Score and clock (stat or table)
Events
| where match_id == _match_id
| top 1 by seq_no desc
| project minute = round(iff(period == 2, 45.0, 0.0) + clock_ms / 60000.0, 1), score_home, score_away

// Tile 2. Control score per team over time (line chart: x = minute, y = control, series = team_id)
TeamState
| where match_id == _match_id
| project minute, team_id, control = round(control)
| order by minute asc

// Tile 3. Momentum shifts and key moments (table)
Triggers
| where match_id == _match_id and insight_type in ("momentum_shift", "key_moment", "player_form")
| project minute, insight_type, rule_id, team_id, player_id, metrics
| order by minute desc

// Tile 4. Latest window per team: possession, pass accuracy, turnovers, PPDA (table)
TeamState
| where match_id == _match_id
| summarize arg_max(minute, *) by team_id
| project team_id, minute, possession_pct = round(100 * possession_share, 1),
    pass_accuracy_pct = round(100 * pass_accuracy, 1), turnovers, own_half_turnovers,
    ppda = round(ppda, 1), tempo = round(tempo, 1), control = round(control)

// Tile 5. Insight pipeline (pie or column: status counts, latest status per insight)
InsightStatus
| where match_id == _match_id
| summarize arg_max(recorded_at, *) by insight_id
| summarize insights = count() by status

// Tile 6. Insights (table)
InsightStatus
| where match_id == _match_id
| summarize arg_max(recorded_at, *) by insight_id
| project minute, insight_type, team_id, headline, audit_status, status, approved_by
| order by minute desc

// Tile 7. Feed health per minute (time chart: x = window_start, y = p50_ms and p95_ms)
FeedHealth
| where match_id == _match_id
| project window_start, messages, p50_ms, p95_ms, max_ms
| order by window_start asc

// Tile 8. Ops alerts (table, newest first). An acknowledgement appends a second row, so
// take each alert's latest state.
OpsAlerts
| where match_id == _match_id
| summarize arg_max(iff(isnotempty(acknowledged_by), 1, 0), *) by alert_id
| project raised_at, severity, kind, message, acknowledged_by
| order by raised_at desc
| take 20

// Tile 9. Model cost per match and per aired insight, last 30 days (table; all matches).
// Cost is priced in code at the configured US$ per million tokens (RunUsage); the Azure
// bill (Cost Management) is the source of truth for what was charged.
RunUsage
| where recorded_at > ago(30d)
| summarize runs = count(), calls = sum(calls), cost_usd = round(sum(cost_usd), 4),
    aired = sum(aired_insights) by match_id, kind
| extend cost_per_aired_insight = iff(aired > 0, round(cost_usd / aired, 5), real(null))
| order by cost_usd desc

// Tile 10. Model cost per day by run kind (column chart: x = day, y = cost_usd, series = kind)
RunUsage
| where recorded_at > ago(30d)
| summarize cost_usd = round(sum(cost_usd), 4) by day = startofday(recorded_at), kind
| order by day asc
