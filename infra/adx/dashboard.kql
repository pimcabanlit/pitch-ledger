// Pitch Ledger control room: ADX dashboard tile queries.
// Create the dashboard in the Azure Data Explorer web UI (Dashboards -> New dashboard),
// add the free cluster and database `matchdata` as the data source, add a parameter
// `_match_id` (single selection, query: Events | distinct match_id), then one tile per
// query below. Tiles only filter, order and chart rows the engine wrote; they never
// compute football metrics, so the dashboard shows the same numbers as the studio.

// Tile 1. Score and clock (stat or table)
Events
| where match_id == _match_id
| top 1 by seq_no desc
| project minute = round(iff(period == 2, 45.0, 0.0) + clock_ms / 60000.0, 1), score_home, score_away

// Tile 2. Control score per team over time (time chart: x = minute, y = control, series = team_id)
TeamState
| where match_id == _match_id
| project minute, team_id, control
| order by minute asc

// Tile 3. Momentum shifts and key moments (table)
Triggers
| where match_id == _match_id and insight_type in ("momentum_shift", "key_moment", "player_form")
| project minute, insight_type, rule_id, team_id, player_id, metrics
| order by minute desc

// Tile 4. Latest window per team: possession, pass accuracy, turnovers, PPDA (table)
TeamState
| where match_id == _match_id
| summarize arg_max(minute, *) by team_id
| project team_id, minute, possession_share, pass_accuracy, turnovers, own_half_turnovers, ppda, tempo, control

// Tile 5. Insight pipeline (pie or column: status counts, latest status per insight)
InsightStatus
| where match_id == _match_id
| summarize arg_max(recorded_at, *) by insight_id
| summarize insights = count() by status

// Tile 6. Insights (table)
InsightStatus
| where match_id == _match_id
| summarize arg_max(recorded_at, *) by insight_id
| project minute, insight_type, team_id, headline, audit_status, status, approved_by
| order by minute desc

// Tile 7. Feed health per minute (time chart: messages and latency)
FeedHealth
| where match_id == _match_id
| project window_start, messages, p50_ms, p95_ms, max_ms
| order by window_start asc

// Tile 8. Ops alerts (table, newest first)
OpsAlerts
| where match_id == _match_id
| project raised_at, severity, kind, message, acknowledged_by
| order by raised_at desc
| take 20
